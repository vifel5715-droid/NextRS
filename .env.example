# Server-only PostgreSQL connection string. Keep this out of NEXT_PUBLIC_*.
DATABASE_URL=postgres://user:password@localhost:5432/request_system

# Server-only authentication keys. Generate unique, high-entropy values.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
SESSION_SECRET=replace-with-another-long-random-secret

NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Optional: demo-account password set by npm run init-db.
# If omitted, init-db generates random passwords and prints them once.
# INIT_DB_DEMO_PASSWORD=choose-a-strong-demo-password

# Optional: password for npm run reset-admin.
# ADMIN_RESET_PASSWORD=choose-a-strong-admin-password

# Optional: legacy on-disk uploads folder used by migrate:attachment-storage.
# Defaults to ../../server/uploads relative to this project.
# LEGACY_UPLOADS_DIR=C:\path\to\server\uploads

# During the API migration, point the client at the existing Express service.
# Once all handlers are ported, use the same-origin /api default.
NEXT_PUBLIC_API_BASE_URL=/api
LEGACY_API_ORIGIN=http://localhost:3001

# Socket.IO cannot be proxied by a normal Route Handler. Point it directly at
# the existing backend until it is attached to the Next.js custom server.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Optional shared rate-limit store for the existing backend.
# REDIS_URL=redis://localhost:6379

# Optional cookie topology overrides.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Optional rate-limit and upload-storage caps.
# RATE_LIMIT_AUTH_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_AUTH_LOGIN_MAX=5
# RATE_LIMIT_READ_LIGHT_WINDOW_MS=900000
# RATE_LIMIT_READ_LIGHT_MAX=2000
# RATE_LIMIT_READ_WINDOW_MS=900000
# RATE_LIMIT_READ_MAX=600
# RATE_LIMIT_WRITE_WINDOW_MS=900000
# RATE_LIMIT_WRITE_MAX=200
# MAX_ATTACHMENT_FILE_SIZE_MB=10.5
# MAX_ATTACHMENT_TOTAL_STORAGE_MB=500
