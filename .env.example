# Server-only PostgreSQL connection string. Keep this out of NEXT_PUBLIC_*.
DATABASE_URL=postgresql://postgres:replace-with-url-encoded-password@localhost:5432/RS_DB?connect_timeout=10&sslmode=prefer

# Server-only signing key. Generate a unique value with at least 32 random bytes.
SESSION_SECRET=replace-with-a-long-random-session-secret
# Optional: demo-account password set by npm run init-db.
# If omitted, init-db generates random passwords and prints them once.
# INIT_DB_DEMO_PASSWORD=choose-a-strong-demo-password

# Optional: password for npm run reset-admin.
# ADMIN_RESET_PASSWORD=choose-a-strong-admin-password

# Optional: legacy on-disk uploads folder used only by the one-time
# migrate:attachment-storage script. Defaults to ../../server/uploads.
# LEGACY_UPLOADS_DIR=C:\path\to\server\uploads
